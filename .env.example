# GitHub personal access token, public_repo scope is enough for public repos
GITHUB_TOKEN=

# From the Inngest dashboard
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# The Inngest-hosted webhook URL that GitHub posts to (see `gh-issue watch`)
INNGEST_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=

# Where the embedded Qdrant index lives
GH_ISSUE_DATA_DIR=./.qdrant
