# GitHub personal access token, public_repo scope is enough for public repos
GITHUB_TOKEN=

# From the Inngest dashboard
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# The Inngest-hosted webhook URL that GitHub posts to (see `gh-issue watch`)
INNGEST_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=

# Qdrant, started by docker-compose.yml in this directory
QDRANT_URL=http://localhost:6333

# Where the sweep's per-repo cursors live
GH_ISSUE_DATA_DIR=./.gh-issue

# Where the embedding model is cached (~90 MB, downloaded once)
GH_ISSUE_MODEL_CACHE=./.fastembed_cache
