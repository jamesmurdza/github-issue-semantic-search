# GitHub personal access token, public_repo scope is enough for public repos
GITHUB_TOKEN=

# Inngest. As copied, this uses the local dev server that docker compose starts,
# and the two keys stay empty. For Inngest Cloud, delete the INNGEST_DEV line and
# fill in both keys from the Inngest dashboard.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Qdrant, started by docker-compose.yml in this directory
QDRANT_URL=http://localhost:6333

# Local state: sweep cursors, backfill progress, failure markers, worker heartbeat
GH_ISSUE_DATA_DIR=./.gh-issue

# Where the embedding model is cached (~90 MB, downloaded once)
GH_ISSUE_MODEL_CACHE=./.fastembed_cache
